# Database Configuration
POSTGRES_USER=tutor
POSTGRES_PASSWORD=tutorpass
POSTGRES_DB=learnmate_db
DATABASE_URL=postgresql+asyncpg://tutor:tutorpass@postgres:5432/learnmate_db
SYNC_DATABASE_URL=postgresql+psycopg2://tutor:tutorpass@postgres:5432/learnmate_db

# Redis Configuration (Celery Broker & Result Backend)
REDIS_URL=redis://redis:6379/0

# Object Storage (MinIO)
MINIO_ENDPOINT=minio:9000
MINIO_EXTERNAL_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=textbooks
MINIO_SECURE=false

# Ollama LLM & Embedding Service
OLLAMA_BASE_URL=http://ollama:11434
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
LLM_MODEL=llama3.1
OLLAMA_GENERATION_TIMEOUT_SECONDS=300

# RAG & Scoring Configuration
RELEVANCE_THRESHOLD=0.55
CONTEXT_MIN_SIMILARITY=0.50
CONTEXT_MAX_SIMILARITY_DROP=0.06

# API Configuration
PROJECT_NAME="LearnMateAI"
API_V1_STR=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
